# Copy this file to keystore.properties and replace every value.
# keystore.properties and *.jks are gitignored. Never commit the completed file or keystore.
# Use an absolute path with forward slashes so Gradle resolves it consistently on every machine.
storeFile=C:/secure/JustTheCarbs-upload.jks
storePassword=REPLACE_WITH_UPLOAD_KEYSTORE_PASSWORD
keyAlias=justthecarbs-upload
keyPassword=REPLACE_WITH_UPLOAD_KEY_PASSWORD
