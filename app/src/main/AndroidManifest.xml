<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      CAMERA and INTERNET only (brief §9). No location, contacts, storage, Bluetooth, phone state
      or Health Connect: scanning a barcode and reading a public food database need nothing else.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The app stays fully usable without a camera: manual entry is always available (§9). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".JustTheCarbsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JustTheCarbs.Starting"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.JustTheCarbs.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              How the launcher shortcuts below resolve.

              Matched by action rather than by a component named in the shortcut resource, because a
              shortcut XML has no portable way to name this app: `${applicationId}` is a manifest
              placeholder that ships as literal text from a resource, and `@string/...` is stored
              unresolved — both verified broken against the built APK. Matching by action is
              independent of the debug build's `.debug` applicationId suffix.

              DEFAULT is required for an implicit match. Not exported: these are started by the
              system launcher on the user's behalf from shortcuts this app publishes, and nothing
              outside the app has any business firing them.
            -->
            <intent-filter>
                <action android:name="app.justthecarbs.action.SCAN_BARCODE" />
                <action android:name="app.justthecarbs.action.SCAN_LABEL" />
                <action android:name="app.justthecarbs.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
              Sharing a picture into this app: a screenshot of a barcode, a photo of a packet, a
              picture of a nutrition table.

              Exported by necessity — an intent filter another app can resolve is the whole
              feature — and deliberately the narrowest filter that does the job: ACTION_SEND with
              a single image, never SEND_MULTIPLE and never a text or URL share. The app takes no
              storage or media permission for this; the sender grants a temporary read on one URI
              and MainActivity copies the bytes immediately (see ImportedPhotoStaging).

              What the picture contains is never guessed. It goes to a chooser that asks.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!--
              Long-pressing the app icon offers the two scanners directly, so someone already
              holding the packet can start a scan without passing through Home. The list is static
              (see res/xml/shortcuts.xml) because it never changes, and the actions are read and
              consumed once by MainActivity.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Bundle the barcode model with the app rather than downloading it on first use. A scanner
          that needs a network round-trip before it can read anything would defeat §32's offline
          requirement and slow the very first scan, which is the one that forms the impression.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode,ocr" />

    </application>

</manifest>
