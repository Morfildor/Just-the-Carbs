<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher-shortcut icon for "Search products".

  A lens over the same uneven rules the barcode shortcut draws, rather than a bare magnifier: what
  this shortcut searches is the product database the other two shortcuts scan their way into, and
  the shared rule motif is what says so at 24dp. Drawn rather than borrowed from the Material icon
  font for the reason given in ic_shortcut_barcode.xml — a launcher tints and masks this itself, so
  it must read as one solid silhouette with no reliance on this app's colours.

  Tinted with the app's primary blue, matching ic_shortcut_barcode: search and barcode are both
  ways *into* a product, while the label scanner's green marks it as the one that reads a package.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#2856C5">
    <!--
      The lens, as a ring: an even-odd counter-path rather than a stroke, so the launcher's own
      masking cannot thin it away at small sizes the way a 2dp stroke would.
    -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M10.5,2.5a8,8 0,1 1,0 16a8,8 0,0 1,0 -16zM10.5,4.5a6,6 0,1 0,0 12a6,6 0,0 0,0 -12z" />
    <!-- The handle, angled off the lens on the standard 45 degrees. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M16.4,16.4 L21.5,21.5 L20.1,22.9 L15,17.8z" />
    <!-- Uneven rules inside the lens: the barcode motif, shortened to sit within the glass. -->
    <path android:fillColor="@android:color/white" android:pathData="M7.2,7.6h1.4v5.8h-1.4z" />
    <path android:fillColor="@android:color/white" android:pathData="M9.8,7.6h0.9v5.8h-0.9z" />
    <path android:fillColor="@android:color/white" android:pathData="M12,7.6h1.4v5.8h-1.4z" />
</vector>
