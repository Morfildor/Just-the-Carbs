<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon concept (§56): a package, crossed by a scan beam. Product + reading it + speed.

  Deliberately NOT a syringe, blood drop, glucose meter, pump, medical cross, calorie flame or
  scale. The app is a calculator for packaged food, and the icon should not claim otherwise.

  Two shapes only, so it stays readable at 48dp in a launcher folder.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The package -->
    <path
        android:pathData="M32,30 h44 a9,9 0 0 1 9,9 v30 a9,9 0 0 1 -9,9 h-44 a9,9 0 0 1 -9,-9 v-30 a9,9 0 0 1 9,-9 z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineJoin="round" />

    <!-- The scan beam, running past the package on both sides -->
    <path
        android:pathData="M14,50.5 h80 v7 h-80 z"
        android:fillColor="#FFFFFF" />

</vector>
