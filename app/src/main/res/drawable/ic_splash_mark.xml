<?xml version="1.0" encoding="utf-8"?>
<!--
  The splash mark: the launcher icon's own two layers, drawn together.

  The splash draws `windowSplashScreenAnimatedIcon` alone, with no adaptive-icon background behind
  it, so it cannot simply name the adaptive icon. It references the launcher's layers instead of
  copying their paths and colours, so the app always opens with the icon the user tapped.

  That is the fix for the defect this replaced (2026-09-24): an earlier copy hard-coded a white
  mark over "the launcher's coral plate" by pointing at `ic_launcher_background`. The launcher
  redesign (68c85a3) made that colour cream and moved the coral to the mark, so the splash drew
  white on cream and was effectively invisible. Referencing the layers means a future icon change
  cannot leave the splash behind again. `SplashIconVisibilityTest` renders the resolved icon over
  the splash background and fails if the mark does not reach 3:1.

  The foreground already keeps its mark inside the adaptive icon's 72dp safe zone, which is the
  same proportion the splash reserves for an icon without a background, so no rescaling is needed.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
