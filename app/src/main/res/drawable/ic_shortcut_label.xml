<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher-shortcut icon for "Scan nutrition label".

  A framed panel with rules inside it: the nutrition table the label scanner exists to read, drawn
  distinctly enough from the barcode shortcut that the two are told apart in a launcher's long-press
  sheet at a glance. See ic_shortcut_barcode.xml for why these are drawn rather than borrowed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#147C3B">
    <!-- The panel outline. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,3h16a1,1 0,0 1,1 1v16a1,1 0,0 1,-1 1h-16a1,1 0,0 1,-1 -1v-16a1,1 0,0 1,1 -1zM5,5v14h14v-14z" />
    <!-- The printed rows, uneven like a real table. -->
    <path android:fillColor="@android:color/white" android:pathData="M7,8h10v1.6h-10z" />
    <path android:fillColor="@android:color/white" android:pathData="M7,11.2h6.5v1.6h-6.5z" />
    <path android:fillColor="@android:color/white" android:pathData="M7,14.4h8.5v1.6h-8.5z" />
</vector>
