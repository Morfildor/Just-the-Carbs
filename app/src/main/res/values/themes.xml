<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The real UI is Compose; this theme only paints the window before the first frame, which is
      what stops a light flash on a dark device (§6, §38).
    -->
    <style name="Theme.JustTheCarbs" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <!--
          Black rather than transparent, for the pre-Compose window only: this is what paints
          behind the very first frame. On API 35+ the platform ignores both attributes entirely
          (they are deprecated no-ops under enforced edge-to-edge) and `SystemBarScrim` is what
          actually holds — these remain correct and load-bearing on API 29–34.
        -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!--
      The system splash screen (§6). No artificial delay is added: it is shown only for as long as
      the app genuinely takes to draw its first frame.
    -->
    <style name="Theme.JustTheCarbs.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!--
          The splash draws this icon *alone*, with no adaptive-icon background behind it, so it
          cannot be `ic_launcher_foreground` — that drawable's paths are white and were rendering
          white-on-cream. `ic_splash_mark` carries the launcher's own coral plate with it.
        -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.JustTheCarbs</item>
    </style>
</resources>
